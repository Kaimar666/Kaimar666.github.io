---
import BaseLayout from '../layouts/BaseLayout.astro';
import Intro from '../components/Intro.astro';
import NoteList from '../components/NoteList.astro';
import ProjectList from '../components/ProjectList.astro';
import { site, getNotes, getProjects, href } from '../lib/content';
const allNotes = await getNotes();
const allProjects = await getProjects();
const notes = site.homepage.showNotes ? allNotes.slice(0, site.homepage.noteLimit) : [];
const projects = site.homepage.showProjects ? allProjects.filter((entry) => entry.data.featured).slice(0, site.homepage.projectLimit) : [];
const links = (site.links as { label: string; url: string; description?: string; visible?: boolean }[]).filter((item) => item.visible !== false);
---
<BaseLayout>
  <main id="main">
    <Intro />
    <div class="wrap home-content">
      {(projects.length > 0 || notes.length > 0) && <div class:list={['home-grid', { 'single-section': projects.length === 0 || notes.length === 0 }]}>
        {projects.length > 0 && <section class="home-projects" aria-labelledby="projects-title"><div class="section-heading"><h2 id="projects-title">精选项目</h2><a href={href('/projects/')}>所有项目 <span aria-hidden="true">↗</span></a></div><ProjectList projects={projects} /></section>}
        {notes.length > 0 && <section class="home-notes" aria-labelledby="notes-title"><div class="section-heading"><h2 id="notes-title">最近记录</h2><a href={href('/notes/')}>全部记录 <span aria-hidden="true">↗</span></a></div><NoteList notes={notes} compact /></section>}
      </div>}
      {projects.length === 0 && notes.length === 0 && <section class="home-welcome"><p class="eyebrow">生活与创造</p><h2>从一段记录开始。</h2><p>关于工程，关于运动，也关于日常生活里的想法。</p><a class="text-link" href={href('/about/')}>认识 Kaimar <span aria-hidden="true">↗</span></a></section>}
      {links.length > 0 && <section class="elsewhere"><div class="section-heading"><h2>别处的我</h2></div><div class="outlet-list">{links.map((link) => <div><a href={href(link.url)} target={link.url.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">{link.label} ↗</a>{link.description && <p>{link.description}</p>}</div>)}</div></section>}
    </div>
  </main>
</BaseLayout>
