---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { getProjects, href, formatDate } from '../../lib/content';
export async function getStaticPaths() {
  return (await getProjects()).map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<BaseLayout title={entry.data.title} description={entry.data.summary} noindex={entry.data.draft}>
  <main id="main" class="wrap article-page"><a class="back-link" href={href('/projects/')}><span aria-hidden="true">←</span> 所有项目</a><header class="article-heading"><p class="eyebrow">{entry.data.status}</p><h1>{entry.data.title}</h1>{entry.data.summary && <p>{entry.data.summary}</p>}<div class="entry-meta"><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>{entry.data.draft && <span class="draft-label">草稿</span>}</div>{entry.data.links.length > 0 && <div class="project-actions">{entry.data.links.map((link) => <a href={href(link.url)} target={link.url.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">{link.label} ↗</a>)}</div>}</header>{entry.data.cover && <img class="detail-cover" src={href(entry.data.cover)} alt={entry.data.title} />}<article class="prose narrow-prose"><Content /></article></main>
</BaseLayout>
